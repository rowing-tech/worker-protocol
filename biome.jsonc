{
  // `.jsonc` rather than `.json`, which is the one place this differs from the same config in
  // other repositories here: the two exclusions below are load-bearing and would be widened by
  // somebody who could not see why they were drawn. Biome validates its own configuration against
  // a closed schema and rejects a `"//"` key, so a real comment is the only way to attach the
  // reason to the line it constrains.
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    // Three generated artifacts, each compared byte for byte by a check of its own — `schemas/`
    // by `pnpm schemas:check`, `openapi/` by `pnpm openapi:check`, and rules.json by
    // `pnpm rules:check`. Their bytes belong to their generators and to no other formatter: two
    // formatters over one file is a CI failure nobody can fix without picking a winner, and it
    // arrives on whichever later day a regenerated file first happens to disagree with this one.
    //
    // Markdown is the product. `spec/` and `docs/` are hand-wrapped prose whose line breaks were
    // chosen, and reflowing them would rewrite the artifact this repository exists to publish.
    "includes": [
      "**",
      "!schemas",
      "!openapi",
      "!packages/conformance/rules.json",
      "!**/*.md",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    // 100 is what every hand-written file here already holds, prose included.
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
