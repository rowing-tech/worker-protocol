{
  // `.jsonc` rather than `.json`, which is the one place this differs from the same config in
  // other repositories here: the two exclusions below are load-bearing and would be widened by
  // somebody who could not see why they were drawn. Biome validates its own configuration against
  // a closed schema and rejects a `"//"` key, so a real comment is the only way to attach the
  // reason to the line it constrains.
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    // `schemas/` is generated by packages/schemas and compared byte for byte by `pnpm
    // schemas:check`. Its bytes belong to that generator and to no other formatter — two
    // formatters over one file is a CI failure nobody can fix without picking a winner.
    //
    // Markdown is the product. `spec/` and `docs/` are hand-wrapped prose whose line breaks were
    // chosen, and reflowing them would rewrite the artifact this repository exists to publish.
    "includes": ["**", "!schemas", "!**/*.md", "!pnpm-lock.yaml"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    // 100 is what every hand-written file here already holds, prose included.
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
