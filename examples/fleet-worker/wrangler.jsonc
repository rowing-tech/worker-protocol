{
  // The Worker as Cloudflare sees it. Nothing about the protocol lives here: `mount()` serves the
  // Descriptor at the one route DESC-35 fixes, and every address below it is relative to that — so
  // this file says where the Worker runs and never where its surfaces are.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fleet-worker",
  "main": "src/worker.ts",
  // The newest date the workerd that `@cloudflare/vitest-pool-workers` bundles will start on. A
  // later one here is not a stricter setting, it is a Worker the test runtime refuses to load —
  // so this moves when that runtime does and not when the calendar does.
  "compatibility_date": "2026-08-22",
  "durable_objects": {
    "bindings": [{ "name": "FLEET", "class_name": "Fleet" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Fleet"] }],
  // Two Queues between the outbox and a sink, and where what is given up is kept. Every event an
  // object flushes goes onto `fleet-events`; its consumer reads the subscriptions once per batch and
  // leaves one delivery per matching subscription on `fleet-deliveries`, whose consumer makes the
  // attempt (`consumeQueues` in `@worker-protocol/cloudflare`).
  //
  // `eventHub().deliver` decides whether to retry a delivery and after how long, never past EVT-8's
  // window, so `max_retries` is the ceiling over that decision and not the decision: the default
  // of 3 would end a delivery the hub still wanted to make, so it is the platform's maximum.
  //
  // `fleet-dead` holds what is given up — a delivery refused for good or out of its window, sent
  // there by the consumer with the reason, and a message the platform drops after its last retry,
  // sent there because each consumer names it. It has no consumer: it is for somebody to inspect,
  // and redriving an event past its window is what EVT-8 forbids.
  "queues": {
    "producers": [
      { "binding": "EVENTS", "queue": "fleet-events" },
      { "binding": "DELIVERIES", "queue": "fleet-deliveries" },
      { "binding": "DEAD", "queue": "fleet-dead" }
    ],
    "consumers": [
      { "queue": "fleet-events", "max_retries": 100, "dead_letter_queue": "fleet-dead" },
      { "queue": "fleet-deliveries", "max_retries": 100, "dead_letter_queue": "fleet-dead" }
    ]
  },
  // The Worker that records what this one cannot record about itself — an uncaught exception, an
  // invocation that ran out of CPU — because by then it has stopped running. `wrangler.tail.jsonc`
  // deploys it and `src/tail.ts` argues what it takes and what it throws away. Resolved by service
  // name, so this line is the whole of what the producer knows about it.
  "tail_consumers": [{ "service": "fleet-tail" }],
  // A worker finds work on a schedule, and the schedule is what makes the nudge optional rather
  // than load-bearing: losing one costs latency, and the cron is what makes it never cost work.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "SOURCE_VEHICLES": "ABC-123,DEF-456,GHI-789"
  }
}
