{
  "name": "@worker-protocol/conformance",
  "version": "0.3.1",
  "workerProtocolEdition": "0.2",
  "description": "Point it at a Worker's base URL, get a report of what it complies with",
  "keywords": [
    "worker-protocol",
    "worker",
    "conformance",
    "verifier",
    "cli",
    "openapi",
    "interoperability",
    "rowing-tech"
  ],
  "license": "Apache-2.0",
  "author": "Rowing Tech, S.A. (https://rowing.tech)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rowing-tech/worker-protocol.git",
    "directory": "packages/conformance"
  },
  "homepage": "https://github.com/rowing-tech/worker-protocol/tree/main/packages/conformance#readme",
  "bugs": "https://github.com/rowing-tech/worker-protocol/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "worker-protocol-conformance": "./dist/cli.js"
  },
  "files": [
    "dist",
    "rules.json",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build && node ../../scripts/pack-legal.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@worker-protocol/schemas": "workspace:*",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@worker-protocol/client": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "wrangler": "4.131.1"
  }
}
